[debug] [2026-08-01T17:21:06.127Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ajramiyazaki-dx/rulesets {"name":"projects/ajramiyazaki-dx/rulesets/2b6b8685-f25d-4d05-88ec-9a33d1a082c8","source":{"files":[{"content":"rules_version = '2';\n\n// 宮崎ひなた青年部 タスク・スケジュール管理アプリ\n// 原則: 既定は全拒否。必要な操作だけを明示的に許可する。\n// 重要: 画面上でボタンを隠すことは防御ではない。防御はこのファイルだけが担う。\n//\n// v6 (2026-07-31)\n//   R-1修正: 承認済み（完了）を本人が取り消せてしまう穴を塞いだ。\n//            現在値も見るようにした。\n//   R-3修正: タスク作成時に必須項目の存在を検証するようにした。\n//            progress の初期化漏れを防ぐ。\n//\n// v7 (2026-08-02)\n//   isAdmin をクライアントから変更できないようにした。切り替えは\n//   Cloud Functions（setMemberAdmin）が Admin SDK で行う。管理者が\n//   0人になる経路を塞ぐため、トランザクションで残り人数を確かめている。\n//   自分自身の status も変更できないようにした。自分を停止すると即座に\n//   ログインできなくなり、管理者が1人なら誰も復旧できなくなる。\n//   画面でボタンを隠していただけで、ルールでは守れていなかった。\n//   auditLogs（管理操作の記録）を追加した。\n//\n// v8 (2026-08-02)\n//   members の削除をクライアントから禁止した。削除は Cloud Functions\n//   （deleteMember）が Authentication と Firestore の両方を消す。\n//   クライアントから消せると、Firestore だけ消えて Auth が残る不整合を\n//   作れてしまい、同じIDで再発行できなくなる。\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ---------- 判定用のヘルパー ----------\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    function isAdmin() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/members/$(request.auth.uid))\n        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isAdmin == true;\n    }\n\n    function isActive() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/members/$(request.auth.uid))\n        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';\n    }\n\n    // 自分がこのタスクの担当者のひとりか\n    function isAssignee() {\n      return isSignedIn() && request.auth.uid in resource.data.assigneeUids;\n    }\n\n    // 管理者権限を書き換えようとしているか。\n    // クライアントからは付与も解除もさせない（Cloud Functions が行う）。\n    function changesAdminFlag() {\n      return request.resource.data.isAdmin != resource.data.isAdmin;\n    }\n\n    // 自分自身の状態（有効／停止）を書き換えようとしているか。\n    // 自分を停止すると即座にログインできなくなるため禁じる。\n    function changesOwnStatus(uid) {\n      return isSelf(uid) && request.resource.data.status != resource.data.status;\n    }\n\n    // 変更しようとしているのが progress の中の「自分の分」だけか\n    function onlyMyProgress() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress'])\n        && request.resource.data.progress.diff(resource.data.progress)\n             .affectedKeys().hasOnly([request.auth.uid]);\n    }\n\n    // 自分の進捗を、その値に変えてよいか\n    //\n    // 承認あり（needsApproval: true）\n    //   すでに「完了」＝管理者が承認済み。本人はもう動かせない。\n    //   それ以外なら「未着手（取り消し）」「完了報告」にできる。\n    //\n    // 承認なし（needsApproval: false）\n    //   本人が「完了」まで押せる。押し間違いは「未着手」に戻せる。\n    function allowedStatus() {\n      return resource.data.needsApproval == true\n        ? (resource.data.progress[request.auth.uid] != '完了'\n           && request.resource.data.progress[request.auth.uid] in ['未着手', '完了報告'])\n        : request.resource.data.progress[request.auth.uid] in ['未着手', '完了'];\n    }\n\n    // タスク作成時に、必要な項目が揃っているか\n    // progress の初期化を忘れると、担当者が一切操作できなくなるため必須にする\n    function validNewTask() {\n      return request.resource.data.keys()\n               .hasAll(['title', 'assigneeUids', 'progress', 'needsApproval'])\n        && request.resource.data.assigneeUids.size() > 0\n        && request.resource.data.progress.keys().hasAll(request.resource.data.assigneeUids);\n    }\n\n\n    // ---------- members : アカウント ----------\n    // 表示名が互いの画面に出るため、有効なメンバーは互いに読める。\n    //\n    // 管理者にもできないこと：\n    //   isAdmin の変更            → Cloud Functions のみ（管理者0人を防ぐため）\n    //   自分自身の status の変更   → 自分を停止して詰むのを防ぐため\n    //   削除                     → Cloud Functions のみ（Authと足並みを揃えるため）\n    match /members/{uid} {\n      allow read:   if isActive() || isAdmin();\n      allow create: if isAdmin();\n      allow update: if (isAdmin() && !changesAdminFlag() && !changesOwnStatus(uid))\n                    || (isSelf(uid)\n                        && request.resource.data.diff(resource.data)\n                             .affectedKeys().hasOnly(['fcmToken']));\n      allow delete: if false;\n    }\n\n\n    // ---------- tasks : タスク ----------\n    // 有効なメンバー全員が読める（共有ボード）。作成・編集・削除は管理者のみ。\n    //\n    // 担当者ができること：\n    //   progress の中の「自分の分」だけを書き換える。\n    //   承認あり → 未着手 ／ 完了報告（承認済みは動かせない）\n    //   承認なし → 未着手 ／ 完了\n    //\n    // 管理者ができること：\n    //   すべて。承認、差戻（理由を書く）、複数人分をまとめて承認も可。\n    match /tasks/{taskId} {\n      allow read:   if isActive() || isAdmin();\n      allow create: if isAdmin() && validNewTask();\n      allow update: if isAdmin()\n                    || (isActive() && isAssignee() && onlyMyProgress() && allowedStatus());\n      allow delete: if isAdmin();\n    }\n\n\n    // ---------- schedules : 予定 ----------\n    match /schedules/{scheduleId} {\n      allow read:  if isActive() || isAdmin();\n      allow write: if isAdmin();\n    }\n\n\n    // ---------- reads : 確認（既読）記録 ----------\n    // 最も敏感な行動データ。閲覧は管理者と本人のみ。\n    match /reads/{readId} {\n      allow create: if isActive()\n                    && isSelf(request.resource.data.uid);\n      allow read:   if isAdmin() || isSelf(resource.data.uid);\n      allow update: if false;\n      allow delete: if isAdmin();\n    }\n\n\n    // ---------- consents : 同意記録 ----------\n    match /consents/{consentId} {\n      allow create: if isSignedIn()\n                    && isSelf(request.resource.data.uid);\n      allow read:   if isSelf(resource.data.uid) || isAdmin();\n      allow update: if false;\n      allow delete: if isAdmin();\n    }\n\n\n    // ---------- auditLogs : 管理操作の記録 ----------\n    // 暗証番号の再設定と、管理者権限の付与・解除を残す。\n    // 書き込むのは Cloud Functions（Admin SDK）だけ。クライアントからは書けない。\n    // 新しい暗証番号そのものは記録しない。\n    match /auditLogs/{logId} {\n      allow read:  if isAdmin();\n      allow write: if false;\n    }\n\n\n    // ---------- 上記以外は全て拒否 ----------\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-01T17:21:06.077951Z","metadata":{"services":["cloud.firestore"]}}
